# Variables for the Node / Railway deployment. Set them in Railway -> Variables.
# Never commit real values.

# Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public https origin. On Railway you can omit this once a domain is generated
# (RAILWAY_PUBLIC_DOMAIN is used instead).
BETTER_AUTH_URL=https://pantry.example.com

# Receipt scanning + AI recipes (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
RECEIPT_AI_MODEL=gemini-2.5-flash

# Push notifications. Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional
# DATA_DIR=/data                 # mount a Railway volume here
# TRUSTED_ORIGINS=               # extra comma separated origins allowed to POST
# TRUSTED_PROXY_HOPS=1           # reverse proxies in front of the app
# BACKUP_KEEP=7                  # daily SQLite snapshots kept in $DATA_DIR/backups
# NOTIFICATION_HOUR_UTC=7        # hour (UTC) of the daily reminder run
