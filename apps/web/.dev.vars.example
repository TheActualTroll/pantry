# Local Worker secrets for Wrangler / Vite. Copy to `.dev.vars` and fill values.
# Never commit `.dev.vars` or `.dev.vars.<environment>`.
# Production secrets are set in Cloudflare, not in this repository.

# Generate a unique local secret with: openssl rand -base64 32
# Do not reuse the production BETTER_AUTH_SECRET.
BETTER_AUTH_SECRET=replace-with-a-32-plus-character-local-secret
BETTER_AUTH_URL=http://localhost:5173

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Future:
# EMAIL_API_KEY=
